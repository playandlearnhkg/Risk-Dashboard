# Results are large and regenerable, EXCEPT the run report, which is the audit
# trail: it records the environment, the pre-registration state and which gate
# stopped the run. That belongs in version control.
results/**
!results/
!results/**/
!results/**/run_report.json

__pycache__/
*.pyc
.venv/
