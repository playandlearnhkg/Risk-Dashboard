# =============================================================================
# MERIDIAN CAPITAL PARTNERS — secrets
# =============================================================================
# Copy to .env and fill in. .env is gitignored; .env.example is committed.
#   cp .env.example .env
#
# Only SEC_USER_AGENT is required for the default (free) configuration.
# Everything else unlocks an optional provider and is safely absent.
# =============================================================================

# REQUIRED for any SEC EDGAR access (Layer 1 filings, 13-F, Form 4).
# SEC blocks requests that do not identify the caller with a real email.
# Run with --no-filings --no-13f if you would rather not set this.
SEC_USER_AGENT="Meridian Research your.email@example.com"

# --- Optional data providers -------------------------------------------------
# Financial Modeling Prep — earnings transcripts, alternative fundamentals.
FMP_API_KEY=

# Polygon.io — alternative market data provider.
POLYGON_API_KEY=

# FRED — the public endpoint used here needs no key, but setting one raises
# rate limits. https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Layer 6 execution (not used until Layer 6 is built) ---------------------
# Alpaca PAPER trading. Keep the paper URL until you have run for a while.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- Layer 3 AI analysis (not used until Layer 3 is built) -------------------
ANTHROPIC_API_KEY=
